# ============================================
# BIG Analytica Website - Apache Configuration
# ============================================
# This file configures Apache for the BIG Analytica website
# Place this file in your web root directory (public_html, www, etc.)

# ============================================
# URL REWRITING CONFIGURATION
# ============================================
# Enable URL rewriting module
RewriteEngine On

# ============================================
# ADMIN PANEL URL REWRITING
# ============================================
# These rules create clean URLs for the admin panel
# Instead of /admin/admin.html, users can access /admin

# Redirect /admin to admin/admin.html
RewriteRule ^admin/?$ admin/admin.html [L]

# Redirect /admin/dashboard to admin/simple-dashboard.html
RewriteRule ^admin/dashboard/?$ admin/simple-dashboard.html [L]

# Redirect /admin/cms to admin/cms.html
RewriteRule ^admin/cms/?$ admin/cms.html [L]

# Redirect /admin/users to admin/create-user.html
RewriteRule ^admin/users/?$ admin/create-user.html [L]

# ============================================
# COMPRESSION CONFIGURATION
# ============================================
# Enable gzip compression to reduce file sizes and improve loading speed
# This requires mod_deflate module to be enabled on your Apache server

<IfModule mod_deflate.c>
    # Compress text files
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    
    # Compress XML files
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    
    # Compress JavaScript files
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    
    # Compress JSON files
    AddOutputFilterByType DEFLATE application/json
    
    # Compress SVG files
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ============================================
# CACHING CONFIGURATION
# ============================================
# Set cache headers to improve performance
# This requires mod_expires module to be enabled on your Apache server

<IfModule mod_expires.c>
    # Enable expiration control
    ExpiresActive on
    
    # Cache CSS files for 1 year
    ExpiresByType text/css "access plus 1 year"
    
    # Cache JavaScript files for 1 year
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    
    # Cache images for 1 year
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    
    # Cache fonts for 1 year
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    
    # Cache HTML files for 1 hour (shorter cache for dynamic content)
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# ============================================
# SECURITY HEADERS
# ============================================
# Add security headers to protect against common attacks
# This requires mod_headers module to be enabled on your Apache server

<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options nosniff
    
    # Prevent clickjacking attacks
    Header always set X-Frame-Options DENY
    
    # Enable XSS protection
    Header always set X-XSS-Protection "1; mode=block"
    
    # Prevent information disclosure
    Header always set X-Permitted-Cross-Domain-Policies "none"
    
    # Referrer policy for privacy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Content Security Policy (adjust as needed)
    # Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data:; font-src 'self' https://cdnjs.cloudflare.com;"
</IfModule>

# ============================================
# FILE ACCESS RESTRICTIONS
# ============================================
# Protect sensitive files from direct access

# Block access to .htaccess file
<Files ".htaccess">
    Order allow,deny
    Deny from all
</Files>

# Block access to configuration files
<Files "*.md">
    Order allow,deny
    Deny from all
</Files>

# Block access to backup files
<Files "*.bak">
    Order allow,deny
    Deny from all
</Files>

# Block access to temporary files
<Files "*.tmp">
    Order allow,deny
    Deny from all
</Files>

# ============================================
# ERROR PAGES (OPTIONAL)
# ============================================
# Custom error pages for better user experience
# Uncomment and customize these if you want custom error pages

# ErrorDocument 404 /404.html
# ErrorDocument 500 /500.html
# ErrorDocument 403 /403.html

# ============================================
# HTTPS REDIRECTION (RECOMMENDED)
# ============================================
# Force HTTPS for security (uncomment if you have SSL certificate)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================
# WWW REDIRECTION (OPTIONAL)
# ============================================
# Redirect www to non-www (or vice versa)
# Uncomment and modify based on your preference

# Redirect www to non-www
# RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
# RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Redirect non-www to www
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]
